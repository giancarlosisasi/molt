# name: test_pull_request_lookup_sends_the_documented_graphql_query
  '''
  query {
    repo__0: repository(
      owner: "emotion-js",
      name: "emotion"
    ) {
      pull__1613: pullRequest(number: 1613) {
        ...PullFragment
      }
    }
  }
  fragment PullFragment on PullRequest {
    url
    author {
      login
      url
    }
    mergeCommit {
      commitUrl
      abbreviatedOid
    }
  }
  
  '''
# ---
