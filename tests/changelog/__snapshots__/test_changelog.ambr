# serializer version: 1
# name: test_commit_lookup_sends_the_documented_graphql_query
  '''
  query {
    repo__0: repository(
      owner: "emotion-js",
      name: "emotion"
    ) {
      commit__a085003: object(expression: "a085003") {
        ... on Commit {
          ...CommitFragment
        }
      }
    }
  }
  fragment CommitFragment on Commit {
    commitUrl
    associatedPullRequests(first: 50) {
      nodes {
        number
        url
        mergedAt
        author {
          login
          url
        }
      }
    }
    author {
      user {
        login
        url
      }
    }
  }
  
  '''
# ---
