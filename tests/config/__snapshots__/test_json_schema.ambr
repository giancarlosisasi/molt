        'description': 'Groups that share a version only when they happen to be released together.',
        'items': dict({
          'items': dict({
            'type': 'string',
          }),
          'type': 'array',
        }),
        'title': 'Linked',
        'type': 'array',
      }),
      'private_packages': dict({
        'anyOf': list([
          dict({
            '$ref': '#/$defs/PrivatePackages',
