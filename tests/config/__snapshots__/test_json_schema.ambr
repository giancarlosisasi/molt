                'anyOf': list([
                  dict({
                    'additionalProperties': True,
                    'type': 'object',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
            ]),
            'type': 'array',
          }),
          dict({
            'type': 'string',
          }),
          dict({
            'const': False,
            'type': 'boolean',
          }),
        ]),
        'default': list([
          'molt.changelog.default',
          None,
        ]),
        'description': 'Changelog generator to run, or a table carrying that generator plus an entry template and the release-date switch.',
        'title': 'Changelog',
      }),
      'commit': dict({
        'anyOf': list([
          dict({
            'maxItems': 2,
            'minItems': 2,
            'prefixItems': list([
              dict({
                'type': 'string',
              }),
              dict({
                'anyOf': list([
                  dict({
                    'additionalProperties': True,
                    'type': 'object',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
              }),
            ]),
            'type': 'array',
          }),
          dict({
            'type': 'string',
          }),
          dict({
            'type': 'boolean',
          }),
        ]),
        'default': False,
        'description': 'Commit generator to run after version/publish, with optional options.',
        'title': 'Commit',
      }),
      'ecosystem': dict({
        'default': 'auto',
        'description': 'Which workspace backend discovers packages, versions and internal deps.',
        'enum': list([
          'auto',
          'uv',
        ]),
        'title': 'Ecosystem',
        'type': 'string',
      }),
      'fixed': dict({
        'default': list([
        ]),
        'description': 'Groups of packages always released together, at the same shared version.',
        'items': dict({
          'items': dict({
            'type': 'string',
          }),
          'type': 'array',
        }),
        'title': 'Fixed',
        'type': 'array',
      }),
      'forge': dict({
        'default': 'github',
        'description': 'Which forge backend drives release automation.',
        'enum': list([
