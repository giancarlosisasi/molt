        ]),
        'title': 'Forge',
        'type': 'string',
      }),
      'format': dict({
        'default': False,
        'description': 'Optional external formatter run over the files molt writes.',
        'enum': list([
          'mdformat',
          False,
        ]),
        'title': 'Format',
      }),
      'ignore': dict({
        'default': list([
        ]),
        'description': 'Packages that must never be released; globs are expanded at load time.',
        'items': dict({
          'type': 'string',
        }),
        'title': 'Ignore',
        'type': 'array',
      }),
      'linked': dict({
