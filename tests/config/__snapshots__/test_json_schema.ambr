# serializer version: 1
# name: test_generates_the_expected_json_schema
  dict({
    '$defs': dict({
      'ChangelogOptions': dict({
        'description': '''
          The changelog subsystem written as one table: ``changelog = { generator, template, dates }``.
          
          molt-native in all but its first member. changesets has a ``changelog`` option and nothing else
          here -- there is no entry template upstream at all (research README section 5 item 5) -- so
          ``template`` and ``dates`` have no ``camelCase`` migration alias, because there is nothing to
          migrate from.
          
          Every member is optional. An empty table is therefore exactly the defaults, which is what makes
          ``changelog = { dates = true }`` mean "the built-in generator, dated" rather than "no
          generator".
          
          ``generator = false`` is accepted and means what ``changelog = false`` means -- no
          ``CHANGELOG.md`` is written. Odd to write beside a ``template``, but refusing it would be a
          second, differently-shaped rule for one concept.
        ''',
        'properties': dict({
          'dates': dict({
            'default': False,
            'description': 'Give the changelog template a release date (one timestamp per version run).',
            'title': 'Dates',
            'type': 'boolean',
          }),
          'generator': dict({
            'anyOf': list([
              dict({
                'maxItems': 2,
                'minItems': 2,
                'prefixItems': list([
                  dict({
                    'type': 'string',
                  }),
                  dict({
                    'anyOf': list([
                      dict({
                        'additionalProperties': True,
                        'type': 'object',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                  }),
                ]),
                'type': 'array',
              }),
              dict({
                'type': 'string',
              }),
              dict({
                'const': False,
                'type': 'boolean',
              }),
            ]),
            'default': list([
              'molt.changelog.default',
              None,
            ]),
            'description': 'Changelog generator to run, with optional generator options.',
            'title': 'Generator',
          }),
          'template': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Filename of a Jinja2 changelog-entry template, resolved against the workspace root.',
            'title': 'Template',
          }),
        }),
        'title': 'ChangelogOptions',
        'type': 'object',
      }),
      'PrivatePackages': dict({
        'description': '''
          Whether packages marked unpublishable are still versioned.
          
          Private distributions -- apps and internal tools you version but never upload -- are versioned
          by default so their internal dependency pins stay correct. The Python marker is the
          ``Private :: Do Not Upload`` classifier (research doc 02 section 12.1), standing in for npm's
          ``"private": true``.
        ''',
        'properties': dict({
          'version': dict({
            'default': True,
            'description': 'Version private packages alongside the rest.',
            'title': 'Version',
            'type': 'boolean',
          }),
        }),
        'title': 'PrivatePackages',
        'type': 'object',
      }),
      'SnapshotOptions': dict({
        'description': '''
          Snapshot-release options (``config.ts:111-134``), reshaped for PEP 440.
          
          ``prerelease_template`` has **no** default upstream -- the key is simply absent from the
          normalized object (research doc 02 section 1.4, "the type lies"). pydantic materializes it as
          ``None`` instead, so absent, ``None`` and unset must stay interchangeable to every consumer.
          The empty string is rejected rather than treated as absent, matching valibot's
          ``minLength(1)``.
        ''',
        'properties': dict({
          'prerelease_template': dict({
            'anyOf': list([
              dict({
                'minLength': 1,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Template for the snapshot version suffix. Placeholders: {tag}, {commit}, {commit-short}, {timestamp}, {datetime}.',
            'title': 'Prerelease Template',
          }),
          'use_calculated_version': dict({
            'default': False,
            'description': 'Base the snapshot on the changeset-derived version instead of 0.0.0.',
            'title': 'Use Calculated Version',
            'type': 'boolean',
          }),
        }),
        'title': 'SnapshotOptions',
        'type': 'object',
      }),
    }),
    'description': '''
      A fully normalized molt configuration.
      
      Every option is settable by its canonical ``snake_case`` name and by the changesets
      ``camelCase`` spelling, both landing on the same field, so a changesets configuration migrates
      unchanged. Supplying *both* spellings of one option is an error rather than a silent
      precedence rule -- see :mod:`molt.config.parse`.
    ''',
    'properties': dict({
      'base_branch': dict({
        'default': 'main',
        'description': 'Git ref used as the comparison base for "what changed".',
        'title': 'Base Branch',
        'type': 'string',
      }),
      'bump_workspace_sources_only': dict({
        'default': False,
        'description': 'Only rewrite dependency pins that are backed by a workspace source.',
